# Template for the backend's environment. Copy to .env and fill in real
# values. Every variable the code reads is listed; the value shown is the
# built-in default where one exists, otherwise a placeholder.

# ── Core ────────────────────────────────────────────────────────────────────
# SQLAlchemy database URL (also used by Alembic and the seed scripts).
DATABASE_URL=postgresql://policygpt_user:your_password@localhost:5432/policygpt_db
# Refuse-to-run switch for the seed scripts: they exit when this is "production".
ENVIRONMENT=development

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Required: the app refuses to start without it.
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
# Access tokens are short-lived; the client swaps its refresh token for a
# new pair through POST /auth/refresh (rotated, stored hashed).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Base URL of the Angular app, used in password-reset e-mail links.
FRONTEND_BASE_URL=http://localhost:4200

# ── HTTP / CORS ─────────────────────────────────────────────────────────────
# Comma-separated explicit origins; never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Set to true only behind a proxy you control; audit logging then records the
# client address from X-Forwarded-For instead of the socket peer.
TRUSTED_PROXY=false

# ── Periodic maintenance (single in-process loop) ───────────────────────────
DEADLINE_REMINDER_INTERVAL_HOURS=24
DEADLINE_REMINDER_STARTUP_DELAY_SECONDS=30
DEADLINE_REMINDER_THRESHOLD_DAYS=7

# ── Reports ─────────────────────────────────────────────────────────────────
# Generated report files older than this are deleted and marked expired.
REPORT_RETENTION_DAYS=30

# ── E-mail (Brevo SMTP) ─────────────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-brevo-login
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
BREVO_FROM_EMAIL=noreply@policygpt.gov
BREVO_FROM_NAME=PolicyGPT

# ── AI / Groq ───────────────────────────────────────────────────────────────
# Required for the AI helpdesk and knowledge ingestion features.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=2

# ── Knowledge-sync worker threads ───────────────────────────────────────────
SYNC_WORKER_THREADS=2
SYNC_MAX_RETRIES=3
SYNC_IN_BACKGROUND=true

# ── Seed scripts ────────────────────────────────────────────────────────────
# Credentials are read from the environment; no password is hardcoded.
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@policygpt.gov
SEED_SUPER_ADMIN_PASSWORD=change-me-superadmin
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@policygpt.gov
SEED_ADMIN_PASSWORD=change-me-admin
# Users that backend/seed_realistic_data.py attaches seeded rows to.
SEED_GOV_OFFICIAL_EMAIL=govofficial@m2test.com
